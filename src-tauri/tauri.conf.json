{
  "productName": "TTS Helper",
  "version": "6.8.0",
  "identifier": "com.panku.io",
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "build": {
    "beforeDevCommand": "yarn start --port 1420",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/tts-helper/browser"
  },
  "plugins": {
    "cors-fetch": {
      "include": ["/^https?:\/\//i"]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "TTS Helper",
        "width": 1000,
        "height": 800,
        "minHeight": 450,
        "minWidth": 350
      }
    ]
  }
}